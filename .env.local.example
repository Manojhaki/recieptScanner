# Anthropic API key — https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Google service account (used to write to the shared Google Sheet)
# — see README.md for step-by-step setup
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=

# The spreadsheet every receipt gets appended to (the long ID in its URL)
GOOGLE_SHEET_ID=

# Tab name within that spreadsheet (defaults to "Sheet1" if unset)
GOOGLE_SHEET_TAB=
